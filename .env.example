# Wabtechs Cloud — Environment Variables

# ─── Core API URL ──────────────────────────────────────────
# Server-side: used by Next.js rewrites and server components.
# Client-side: used by the SDK to make API calls from the browser.
#
# LOCAL:          http://localhost:3001
# VERCEL PREVIEW: https://wabtechs-core.vercel.app
# PRODUCTION:     https://api.wabtechs.com
CORE_API_URL=
NEXT_PUBLIC_CORE_API_URL=

# ─── App URL ──────────────────────────────────────────────
# PUBLIC: The public URL of this Cloud instance.
#
# LOCAL:          http://localhost:3000
# VERCEL PREVIEW: https://wabtechs-cloud-<team>.vercel.app
# PRODUCTION:     https://cloud.wabtechs.com
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=Wabtechs Cloud

# ─── Auth ──────────────────────────────────────────────────
# SERVER-ONLY: Used to sign session cookies. Never expose via NEXT_PUBLIC_*.
# Generate a strong random value for production.
AUTH_SECRET=

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false
