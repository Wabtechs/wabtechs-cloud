{
  "name": "@wabtechs/sdk",
  "version": "0.0.1",
  "description": "Wabtechs SDK — Client pour la communication avec Wabtechs Core.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/auth.ts src/client.ts src/schemas.ts --format esm --dts --clean --sourcemap --external react --external react-dom --external zustand",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "zustand": "^5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0"
  },
  "peerDependencies": {
    "zustand": ">=4.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "react": "^19.0.0"
  }
}
