{
  "name": "@wabtechs/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Composants de Wabtechs UI (primitives accessibles, provider, layouts).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./provider": {
      "types": "./dist/providers/wabtechs-provider.d.ts",
      "import": "./dist/providers/wabtechs-provider.js"
    },
    "./alert": {
      "types": "./dist/components/alert.d.ts",
      "import": "./dist/components/alert.js"
    },
    "./aspect-ratio": {
      "types": "./dist/components/aspect-ratio.d.ts",
      "import": "./dist/components/aspect-ratio.js"
    },
    "./avatar": {
      "types": "./dist/components/avatar.d.ts",
      "import": "./dist/components/avatar.js"
    },
    "./badge": {
      "types": "./dist/components/badge.d.ts",
      "import": "./dist/components/badge.js"
    },
    "./button": {
      "types": "./dist/components/button.d.ts",
      "import": "./dist/components/button.js"
    },
    "./card": {
      "types": "./dist/components/card.d.ts",
      "import": "./dist/components/card.js"
    },
    "./container": {
      "types": "./dist/components/container.d.ts",
      "import": "./dist/components/container.js"
    },
    "./empty-state": {
      "types": "./dist/components/empty-state.d.ts",
      "import": "./dist/components/empty-state.js"
    },
    "./form-field": {
      "types": "./dist/components/form-field.d.ts",
      "import": "./dist/components/form-field.js"
    },
    "./grid": {
      "types": "./dist/components/grid.d.ts",
      "import": "./dist/components/grid.js"
    },
    "./input": {
      "types": "./dist/components/input.d.ts",
      "import": "./dist/components/input.js"
    },
    "./label": {
      "types": "./dist/components/label.d.ts",
      "import": "./dist/components/label.js"
    },
    "./scroll-area": {
      "types": "./dist/components/scroll-area.d.ts",
      "import": "./dist/components/scroll-area.js"
    },
    "./separator": {
      "types": "./dist/components/separator.d.ts",
      "import": "./dist/components/separator.js"
    },
    "./skeleton": {
      "types": "./dist/components/skeleton.d.ts",
      "import": "./dist/components/skeleton.js"
    },
    "./spinner": {
      "types": "./dist/components/spinner.d.ts",
      "import": "./dist/components/spinner.js"
    },
    "./stack": {
      "types": "./dist/components/stack.d.ts",
      "import": "./dist/components/stack.js"
    },
    "./textarea": {
      "types": "./dist/components/textarea.d.ts",
      "import": "./dist/components/textarea.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip.d.ts",
      "import": "./dist/components/tooltip.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:js && pnpm build:css",
    "build:js": "tsup src/index.ts src/components/*.tsx src/providers/*.tsx --format esm --dts --clean --sourcemap --external react --external react-dom --external lucide-react --external @wabtechs/hooks --external @wabtechs/icons --external @wabtechs/themes --external @wabtechs/utils --external @wabtechs/tokens",
    "build:css": "tailwindcss -i src/styles/input.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "clean": "node ../../scripts/clean.mjs dist"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.1.1",
    "@wabtechs/hooks": "workspace:*",
    "@wabtechs/icons": "workspace:*",
    "@wabtechs/themes": "workspace:*",
    "@wabtechs/utils": "workspace:*",
    "class-variance-authority": "^0.7.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "jest-axe": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  }
}
